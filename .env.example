# This file contains placeholders only; it is not loaded automatically.
# Export these variables in your shell, or load this file with your own tooling.
LLM_API_KEY=YOUR_API_KEY
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro

# Set false for services that do not accept the extra thinking fields.
LLM_SEND_THINKING_CONFIG=true

# Optional paths, relative to your current working directory.
RCTA_INPUT_DIR=inputs
RCTA_OUTPUT_DIR=outputs
RCTA_LOG_DIR=logs
